# ==============================================================================
# Antigravity Reader Configuration
# Copy this file to .env or set environment variables directly
# ==============================================================================

# Server binding port (default: 5050)
ANTIGRAVITY_PORT=5050

# Server binding host (default: 0.0.0.0)
ANTIGRAVITY_HOST=0.0.0.0

# Path to Antigravity brain conversation storage directory
# (default: ~/.gemini/antigravity-ide/brain)
# ANTIGRAVITY_BRAIN_DIR=/home/user/.gemini/antigravity-ide/brain
